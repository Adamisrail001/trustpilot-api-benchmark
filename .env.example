# Copy this file to .env and fill in your own real values.
# .env is listed in .gitignore — never commit it, and never paste real keys
# into scripts, output files, commit messages, or anything pushed to a
# Gist/GitHub repo. This file must never contain real credentials — placeholders only.

# --- Apify ---
APIFY_API_TOKEN=
# The original test used a private/custom actor (automation-lab~trustpilot).
# You likely don't have access to that exact actor — set this to a
# Trustpilot-reviews Actor you do have access to (e.g. one from the Apify
# Store) that accepts a companyUrls/maxReviewsPerCompany/sort input shape.
APIFY_ACTOR_ID=

# --- DataForSEO ---
# HTTP Basic Auth (login/password pair), per DataForSEO's documented auth model.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Outscraper ---
OUTSCRAPER_API_KEY=

# --- Lobstr.io ---
LOBSTR_API_KEY=
# Only used by scripts/lobstr-prerun-validate.js; scripts/lobstr-benchmark.js
# discovers/creates the crawler itself. Leave blank unless you already have one.
LOBSTR_CRAWLER_ID=
# Requires a pre-configured squid (crawl configuration) for the Trustpilot
# Reviews crawler in your Lobstr.io account.
LOBSTR_SQUID_ID=

# --- OpenWeb Ninja ---
OPENWEBNINJA_API_KEY=

# --- Optional run-mode safety flags (read by the benchmark scripts) ---
# Each *-benchmark.js script refuses to make paid/live API calls unless
# explicitly confirmed. Set these only when you intend to spend API credits.
#   CONFIRM_PAID_RUN=yes    node scripts/<provider>-benchmark.js run
#   CONFIRM_SMOKE_RUN=yes   node scripts/<provider>-benchmark.js smoke
# OpenWeb Ninja's script additionally requires you to state your remaining
# monthly quota (no quota-check endpoint exists) before it will run:
#   OPENWEBNINJA_QUOTA_REMAINING=<n from your app.openwebninja.com dashboard>
