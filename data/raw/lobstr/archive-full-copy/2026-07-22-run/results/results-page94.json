        "number_of_reviews": 1,
        "owner_reply": "Hello,\nWe're truly sorry to hear about your experience. We understand how frustrating it must have been to wait so long for your order and feel that you had to manually request the shipment before it was dispatched. Please accept our sincere apologies for any inconvenience caused.\nWe would like to confirm that we have received your email, and our relevant team has processed this matter.\nThank you for your patience and for giving us the opportunity to make things right.",
        "owner_reply_date": "2026-07-22T05:44:51Z",
